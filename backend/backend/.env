# Backend Server Configuration
# Spec requirement: Backend runs on http://localhost:8080
PORT=8080

# PostgreSQL Database Connection String
# Spec requirement: Database connection must be changeable via environment variable
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=school_admission;Username=postgres;Password=postgres

# Seat Hold Duration in Seconds (Spec requirement: default 600)
HOLD_DURATION_SECONDS=600

# ASP.NET Core Environment (Development / Production)
ASPNETCORE_ENVIRONMENT=Development
